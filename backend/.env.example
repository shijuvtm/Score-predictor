# PostgreSQL connection string from your cloud database provider.
# Keep credentials private and set sslmode=require for cloud connections.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSLMODE=require

# Generate a long random value and keep it secret; never commit it.
SECRET_KEY=

# Production frontend origin(s), comma-separated. Use explicit origins for credentialed CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set true when serving over HTTPS. Cross-site frontend/backend deployments
# also need SESSION_COOKIE_SAMESITE=None.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Optional: only required to use GET /weather.
OPENWEATHER_API_KEY=

# Optional; defaults to 5000.
PORT=5000
